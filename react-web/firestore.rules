rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().get('active', true) == true; }
    function admin() { return active() && profile().get('role', 'user') == 'admin'; }
    function canCreatePlace() { return active() && profile().get('role', 'user') in ['partner', 'admin']; }
    function referenceId(value) { return value is string ? value : (value is map ? value.get('id', '') : ''); }
    function responsible(owner) {
      let id = referenceId(owner);
      return id != '' && (id == request.auth.uid ||
        (profile().get('role', 'user') == 'partner' && profile().get('partnerId', null) == id));
    }
    function memberPath(placeId) { return /databases/$(database)/documents/places/$(placeId)/members/$(request.auth.uid); }
    function placeAccess(placeId, roles) {
      return active() && (profile().get('role', 'user') == 'admin' ||
        (exists(memberPath(placeId))
          ? get(memberPath(placeId)).data.active == true && get(memberPath(placeId)).data.role in roles
          : responsible(get(/databases/$(database)/documents/places/$(placeId)).data.get('ownerId', ''))));
    }
    function eventAccess(event, transfer) {
      let placeId = event.get('placeId', null);
      return active() && (profile().get('role', 'user') == 'admin' ||
        (placeId is string && placeId != '' && placeAccess(placeId, transfer ? ['owner'] : ['owner', 'manager'])) ||
        (!(placeId is string && placeId != '' && exists(memberPath(placeId))) &&
          responsible(event.get('createdBy', '')) && (!transfer || profile().get('role', 'user') == 'partner')));
    }
    function validLink(event) {
      let placeId = event.get('placeId', null);
      return placeId == null || (placeId is string && placeId != '' &&
        exists(/databases/$(database)/documents/places/$(placeId)) && placeAccess(placeId, ['owner', 'manager']));
    }
    function menuEnabled(placeId) {
      let path = /databases/$(database)/documents/places/$(placeId)/settings/modules;
      return !exists(path) || (get(path).data.schemaVersion == 1 && get(path).data.enabled.get('menu', true) == true);
    }
    function sessionsEnabled(placeId) {
      let path = /databases/$(database)/documents/places/$(placeId)/settings/modules;
      return exists(path) && get(path).data.schemaVersion == 1 && get(path).data.enabled.get('serviceSessions', false) == true;
    }
    function tablesEnabled(placeId) {
      let path = /databases/$(database)/documents/places/$(placeId)/settings/modules;
      return exists(path) && get(path).data.schemaVersion == 1 && get(path).data.enabled.get('tables', false) == true && paidEntitled(placeId, 'tables');
    }
    function paidEntitled(placeId, feature) {
      let path = /databases/$(database)/documents/places/$(placeId)/settings/entitlements;
      let value = get(path).data;
      return exists(path) && value.schemaVersion == 1 &&
        value.status in ['active', 'trialing'] &&
        (value.validUntil == null || value.validUntil > request.time) &&
        value.features.get(feature, false) == true;
    }
    function ordersEnabled(placeId) {
      let path = /databases/$(database)/documents/places/$(placeId)/settings/modules;
      return exists(path) && get(path).data.schemaVersion == 1 && get(path).data.enabled.get('orders', false) == true && paidEntitled(placeId, 'orders');
    }

    match /users/{uid} {
      function validNotificationPreferences() {
        let p = request.resource.data.get('notificationPreferences', null);
        return !('notificationPreferences' in request.resource.data) ||
          (p is map && p.keys().hasOnly(['events', 'orders', 'marketing']) &&
            p.events is bool && p.orders is bool && p.marketing is bool);
      }
      // Preserve legacy public author hydration (Flutter reads the event creator).
      // A separate public profile projection is needed before restricting these reads.
      allow get: if true;
      allow list: if admin();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.id == uid &&
        request.resource.data.role == 'user' && request.resource.data.active == true &&
        request.resource.data.partnerId == null &&
        request.resource.data.keys().hasOnly(['id', 'name', 'email', 'photoUrl', 'isAnonymous', 'updatedAt', 'role', 'active', 'partnerId', 'notificationsEnabled', 'notificationPreferences', 'locationSharingEnabled', 'autoCheckinConsentEnabled', 'autoCheckinConsentUpdatedAt']) && validNotificationPreferences();
      // Global role/active changes are performed by audited Cloud Functions.
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id', 'name', 'email', 'photoUrl', 'isAnonymous', 'updatedAt',
          'notificationsEnabled', 'notificationPreferences', 'notificationUpdatedAt', 'locationSharingEnabled', 'lastKnownLocation', 'locationUpdatedAt',
          'autoCheckinConsentEnabled', 'autoCheckinConsentUpdatedAt'
        ]) && request.resource.data.id == uid && validNotificationPreferences();
      match /notification_tokens/{tokenId} {
        function validToken() {
          let d = request.resource.data;
          return d.keys().hasOnly(['token', 'platform', 'isWeb', 'enabled', 'updatedAt']) &&
            d.token is string && d.token.size() > 20 && d.token.size() <= 4096 &&
            d.platform == 'web' && d.isWeb == true && d.enabled is bool && d.updatedAt == request.time;
        }
        allow read: if active() && request.auth.uid == uid;
        allow create, update: if active() && request.auth.uid == uid && validToken();
        allow delete: if active() && request.auth.uid == uid;
      }
      match /notifications/{notificationId} {
        // Trusted delivery workers use the Admin SDK. Clients only read and mark their own messages as read.
        allow read: if active() && request.auth.uid == uid;
        allow create, delete: if false;
        allow update: if active() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
          request.resource.data.readAt == request.time;
      }
    }

    match /commercialPlans/{planKey} {
      // Commercial configuration is published by trusted billing/admin infrastructure.
      allow read: if active() && resource.data.active == true;
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if admin();
      allow write: if false;
    }

    match /places/{placeId} {
      function validAutoCheckinSettings() {
        let d = request.resource.data.get('autoCheckinSettings', {});
        return d is map && d.keys().hasOnly(['autoCheckinEnabled', 'radiusMeters', 'minimumStayMinutes']) &&
          (!('autoCheckinEnabled' in d) || d.autoCheckinEnabled is bool) &&
          (!('radiusMeters' in d) || (d.radiusMeters is number && d.radiusMeters > 0 && d.radiusMeters - d.radiusMeters == 0)) &&
          (!('minimumStayMinutes' in d) || (d.minimumStayMinutes is number && d.minimumStayMinutes > 0 && d.minimumStayMinutes - d.minimumStayMinutes == 0));
      }
      allow read: if true;
      allow create: if canCreatePlace() && request.resource.data.ownerId == request.auth.uid && request.resource.data.id == placeId && validAutoCheckinSettings();
      allow update: if placeAccess(placeId, ['owner', 'manager']) &&
        validAutoCheckinSettings() &&
        referenceId(request.resource.data.ownerId) == referenceId(resource.data.ownerId) &&
        request.resource.data.get('id', placeId) == placeId &&
        (request.resource.data.get('menuSchemaVersion', 1) == resource.data.get('menuSchemaVersion', 1) || (menuEditor() && resource.data.get('menuSchemaVersion', 1) != 2 && request.resource.data.menuSchemaVersion == 2)) &&
        (resource.data.get('menuSchemaVersion', 1) != 2 || (request.resource.data.get('menuItems', []) == resource.data.get('menuItems', []) && request.resource.data.get('menuCategories', []) == resource.data.get('menuCategories', []))) &&
        ((request.resource.data.get('menuItems', []) == resource.data.get('menuItems', []) &&
          request.resource.data.get('menuCategories', []) == resource.data.get('menuCategories', [])) || menuEnabled(placeId));
      function menuEditor() { return placeAccess(placeId, ['owner', 'manager']) && menuEnabled(placeId); }
      function inventoryEnabled() {
        let path = /databases/$(database)/documents/places/$(placeId)/settings/modules;
        return exists(path) && get(path).data.schemaVersion == 1 && get(path).data.enabled.get('inventory', false) == true && paidEntitled(placeId, 'inventory');
      }
      function inventoryEditor() { return placeAccess(placeId, ['owner', 'manager']) && inventoryEnabled(); }
      function inventoryReader() { return placeAccess(placeId, ['owner', 'manager', 'employee']) && inventoryEnabled(); }
      function purchasesEnabled() {
        let path = /databases/$(database)/documents/places/$(placeId)/settings/modules;
        return exists(path) && get(path).data.schemaVersion == 1 && get(path).data.enabled.get('purchases', false) == true && paidEntitled(placeId, 'purchases');
      }
      function purchasesEditor() { return placeAccess(placeId, ['owner', 'manager']) && purchasesEnabled() && inventoryEnabled(); }
      function notificationsEnabled() {
        let path = /databases/$(database)/documents/places/$(placeId)/settings/modules;
        return exists(path) && get(path).data.schemaVersion == 1 && get(path).data.enabled.get('notifications', false) == true && paidEntitled(placeId, 'notifications');
      }
      match /notificationCampaigns/{campaignId} {
        function validCampaign() {
          let d = request.resource.data;
          return d.keys().hasOnly(['title', 'body', 'kind', 'status', 'createdBy', 'createdAt', 'updatedAt']) &&
            d.title is string && d.title.size() > 0 && d.title.size() <= 120 &&
            d.body is string && d.body.size() > 0 && d.body.size() <= 500 &&
            d.kind == 'marketing' && d.status in ['draft', 'cancelled', 'queued', 'sent'] &&
            d.createdBy is string && d.createdAt is timestamp && d.updatedAt == request.time;
        }
        allow read: if placeAccess(placeId, ['owner']) && notificationsEnabled();
        allow create: if placeAccess(placeId, ['owner']) && notificationsEnabled() && validCampaign() &&
          request.resource.data.status == 'draft' && request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdAt == request.time;
        allow update: if placeAccess(placeId, ['owner']) && notificationsEnabled() && validCampaign() &&
          resource.data.status == 'draft' && request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
        allow delete: if false;
      }
      function stockValue(n) { return n is int && n >= 0 && n <= 1000000000000; }
      match /inventoryItems/{itemId} {
        function validItem() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'unit', 'minimumMilli', 'active', 'stockMilli', 'lastMovementId', 'createdAt', 'updatedAt']) &&
            d.name is string && d.name.size() > 0 && d.name.size() <= 100 && d.unit in ['un', 'g', 'ml'] &&
            stockValue(d.minimumMilli) && stockValue(d.stockMilli) && d.active is bool &&
            d.createdAt is timestamp && d.updatedAt == request.time;
        }
        function balanceMovement() {
          let d = request.resource.data;
          let path = /databases/$(database)/documents/places/$(placeId)/inventoryItems/$(itemId)/movements/$(d.lastMovementId);
          return resource.data.active == true && d.lastMovementId is string && d.lastMovementId != resource.data.lastMovementId &&
            !exists(path) && getAfter(path).data.beforeMilli == resource.data.stockMilli &&
            getAfter(path).data.afterMilli == d.stockMilli &&
            d.diff(resource.data).affectedKeys().hasOnly(['stockMilli', 'lastMovementId', 'updatedAt']);
        }
        allow read: if inventoryReader();
        allow create: if inventoryEditor() && validItem() && request.resource.data.stockMilli == 0 &&
          request.resource.data.lastMovementId == null && request.resource.data.createdAt == request.time;
        allow update: if inventoryEditor() && validItem() && request.resource.data.unit == resource.data.unit &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'minimumMilli', 'active', 'updatedAt']) || balanceMovement());
        allow delete: if false;
        match /movements/{movementId} {
          function validMovement() {
            let d = request.resource.data;
            let path = /databases/$(database)/documents/places/$(placeId)/inventoryItems/$(itemId);
            let before = get(path).data;
            let after = getAfter(path).data;
            return d.keys().hasOnly(['itemId', 'type', 'deltaMilli', 'beforeMilli', 'afterMilli', 'unit', 'reason', 'createdBy', 'createdAt', 'purchaseOrderId']) &&
              d.itemId == itemId && d.type in ['entry', 'exit', 'adjustment', 'loss'] &&
              d.deltaMilli is int && d.deltaMilli != 0 && d.deltaMilli >= -1000000000000 && d.deltaMilli <= 1000000000000 &&
              (d.type == 'entry' ? d.deltaMilli > 0 : (d.type in ['exit', 'loss'] ? d.deltaMilli < 0 : true)) &&
              stockValue(d.beforeMilli) && stockValue(d.afterMilli) && d.afterMilli == d.beforeMilli + d.deltaMilli &&
              d.beforeMilli == before.stockMilli && d.afterMilli == after.stockMilli && before.active == true &&
              d.unit == before.unit && after.lastMovementId == movementId && before.lastMovementId != movementId &&
              d.reason is string && d.reason.size() > 0 && d.reason.size() <= 300 &&
              (!('purchaseOrderId' in d) || (d.purchaseOrderId is string && d.purchaseOrderId.size() > 0)) &&
              d.createdBy == request.auth.uid && d.createdAt == request.time;
          }
          allow read: if inventoryReader();
          allow create: if inventoryEditor() && validMovement();
          allow update, delete: if false;
        }
      }
      match /inventoryRecipes/{menuItemId} {
        function componentAt(components, index) {
          let keys = components.keys();
          return keys.size() <= index || (
            keys[index].matches('^[^/]+$') &&
            components[keys[index]].keys().hasOnly(['unit', 'quantityMilli']) &&
            stockValue(components[keys[index]].quantityMilli) && components[keys[index]].quantityMilli > 0 &&
            components[keys[index]].unit in ['un', 'g', 'ml']);
        }
        function validRecipe() {
          let d = request.resource.data;
          return d.keys().hasOnly(['menuItemId', 'components', 'revision', 'active', 'createdAt', 'updatedAt', 'updatedBy']) &&
            d.menuItemId == menuItemId && exists(/databases/$(database)/documents/places/$(placeId)/menuItems/$(menuItemId)) &&
            d.components is map && d.components.size() > 0 && d.components.size() <= 5 &&
            componentAt(d.components, 0) && componentAt(d.components, 1) && componentAt(d.components, 2) &&
            componentAt(d.components, 3) && componentAt(d.components, 4) &&
            d.active is bool && d.revision is int && d.revision > 0 && d.revision <= 2147483647 &&
            d.updatedAt == request.time && d.updatedBy == request.auth.uid;
        }
        allow read: if inventoryReader();
        allow create: if inventoryEditor() && validRecipe() && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
        allow update: if inventoryEditor() && validRecipe() && request.resource.data.revision == resource.data.revision + 1 &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
      match /suppliers/{supplierId} {
        function validSupplier() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'contact', 'active', 'createdAt', 'updatedAt', 'createdBy']) &&
            d.name is string && d.name.size() > 0 && d.name.size() <= 120 && d.contact is string && d.contact.size() <= 300 &&
            d.active is bool && d.createdAt is timestamp && d.updatedAt == request.time && d.createdBy is string;
        }
        allow read: if placeAccess(placeId, ['owner', 'manager', 'employee']) && purchasesEnabled();
        allow create: if purchasesEditor() && validSupplier() && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
        allow update: if purchasesEditor() && validSupplier() && request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.createdBy == resource.data.createdBy && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'contact', 'active', 'updatedAt']);
        allow delete: if false;
      }
      match /purchaseOrders/{orderId} {
        function itemCost1() { return getAfter(/databases/$(database)/documents/places/$(placeId)/purchaseItems/$(orderId + '_1')).data.totalCostCents; }
        function itemCost2() { return request.resource.data.itemCount < 2 ? 0 : getAfter(/databases/$(database)/documents/places/$(placeId)/purchaseItems/$(orderId + '_2')).data.totalCostCents; }
        function itemCost3() { return request.resource.data.itemCount < 3 ? 0 : getAfter(/databases/$(database)/documents/places/$(placeId)/purchaseItems/$(orderId + '_3')).data.totalCostCents; }
        function itemCost4() { return request.resource.data.itemCount < 4 ? 0 : getAfter(/databases/$(database)/documents/places/$(placeId)/purchaseItems/$(orderId + '_4')).data.totalCostCents; }
        function itemCost5() { return request.resource.data.itemCount < 5 ? 0 : getAfter(/databases/$(database)/documents/places/$(placeId)/purchaseItems/$(orderId + '_5')).data.totalCostCents; }
        function receivedItem1() { let d = getAfter(/databases/$(database)/documents/places/$(placeId)/purchaseItems/$(orderId + '_1')).data; return d.receivedMilli == d.quantityMilli; }
        function receivedItem2() { let d = resource.data.itemCount < 2 ? null : getAfter(/databases/$(database)/documents/places/$(placeId)/purchaseItems/$(orderId + '_2')).data; return resource.data.itemCount < 2 || d.receivedMilli == d.quantityMilli; }
        function receivedItem3() { let d = resource.data.itemCount < 3 ? null : getAfter(/databases/$(database)/documents/places/$(placeId)/purchaseItems/$(orderId + '_3')).data; return resource.data.itemCount < 3 || d.receivedMilli == d.quantityMilli; }
        function receivedItem4() { let d = resource.data.itemCount < 4 ? null : getAfter(/databases/$(database)/documents/places/$(placeId)/purchaseItems/$(orderId + '_4')).data; return resource.data.itemCount < 4 || d.receivedMilli == d.quantityMilli; }
        function receivedItem5() { let d = resource.data.itemCount < 5 ? null : getAfter(/databases/$(database)/documents/places/$(placeId)/purchaseItems/$(orderId + '_5')).data; return resource.data.itemCount < 5 || d.receivedMilli == d.quantityMilli; }
        function validOrder() {
          let d = request.resource.data;
          return d.keys().hasOnly(['supplierId', 'status', 'notes', 'itemCount', 'totalCostCents', 'orderedAt', 'receivedAt', 'createdBy', 'receivedBy', 'receiptOperationId', 'createdAt', 'updatedAt']) &&
            d.supplierId is string && d.notes is string && d.notes.size() <= 1000 && d.itemCount is int && d.itemCount > 0 && d.itemCount <= 5 &&
            d.totalCostCents is int && d.totalCostCents >= 0 && d.status in ['ordered', 'received', 'cancelled'] &&
            d.orderedAt is timestamp && d.createdAt is timestamp && d.updatedAt == request.time && d.createdBy is string;
        }
        allow read: if placeAccess(placeId, ['owner', 'manager', 'employee']) && purchasesEnabled();
        allow create: if purchasesEditor() && validOrder() && request.resource.data.status == 'ordered' &&
          request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time &&
          request.resource.data.orderedAt == request.time && request.resource.data.receivedAt == null && request.resource.data.receivedBy == null &&
          get(/databases/$(database)/documents/places/$(placeId)/suppliers/$(request.resource.data.supplierId)).data.active == true &&
          request.resource.data.totalCostCents == itemCost1() + itemCost2() + itemCost3() + itemCost4() + itemCost5();
        allow update: if purchasesEditor() && validOrder() && resource.data.status == 'ordered' &&
          request.resource.data.status == 'received' && request.resource.data.receivedAt == request.time &&
          request.resource.data.receivedBy == request.auth.uid && request.resource.data.receiptOperationId is string &&
          receivedItem1() && receivedItem2() && receivedItem3() && receivedItem4() && receivedItem5() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'receivedAt', 'receivedBy', 'receiptOperationId', 'updatedAt']);
        allow delete: if false;
      }
      match /purchaseItems/{purchaseItemId} {
        function validPurchaseItem() {
          let d = request.resource.data;
          return d.keys().hasOnly(['purchaseOrderId', 'inventoryItemId', 'name', 'unit', 'quantityMilli', 'receivedMilli', 'unitCostMicros', 'totalCostCents', 'receivedAt', 'receivedBy']) &&
            d.purchaseOrderId is string && purchaseItemId.matches('^' + d.purchaseOrderId + '_[1-5]$') &&
            d.inventoryItemId is string && d.name is string && d.name.size() > 0 && d.name.size() <= 100 && d.unit in ['un', 'g', 'ml'] &&
            stockValue(d.quantityMilli) && d.quantityMilli > 0 && stockValue(d.receivedMilli) && d.receivedMilli <= d.quantityMilli &&
            d.unitCostMicros is int && d.unitCostMicros >= 0 && d.unitCostMicros <= 1000000000000 &&
            d.totalCostCents is int && d.totalCostCents >= 0 &&
            d.totalCostCents >= (d.quantityMilli * d.unitCostMicros / 10000000) - 0.5 &&
            d.totalCostCents <= (d.quantityMilli * d.unitCostMicros / 10000000) + 0.5;
        }
        allow read: if placeAccess(placeId, ['owner', 'manager', 'employee']) && purchasesEnabled();
        allow create: if purchasesEditor() && validPurchaseItem() && request.resource.data.receivedMilli == 0 &&
          getAfter(/databases/$(database)/documents/places/$(placeId)/purchaseOrders/$(request.resource.data.purchaseOrderId)).data.status == 'ordered' &&
          get(/databases/$(database)/documents/places/$(placeId)/inventoryItems/$(request.resource.data.inventoryItemId)).data.unit == request.resource.data.unit;
        allow update: if purchasesEditor() && validPurchaseItem() && resource.data.receivedMilli == 0 &&
          request.resource.data.receivedMilli == resource.data.quantityMilli && request.resource.data.receivedAt == request.time &&
          request.resource.data.receivedBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedMilli', 'receivedAt', 'receivedBy']) &&
          getAfter(/databases/$(database)/documents/places/$(placeId)/purchaseOrders/$(resource.data.purchaseOrderId)).data.status == 'received';
        allow delete: if false;
      }
      match /checkins/{uid} {
        function canRecord(source) {
          return active() && (source == 'staff'
            ? placeAccess(placeId, ['owner', 'manager', 'employee'])
            : request.auth.uid == uid && (source in ['manual', 'qr'] ||
              (source == 'geofence' && profile().get('autoCheckinConsentEnabled', false) == true)));
        }
        function validPresence() {
          let d = request.resource.data;
          return d.keys().hasOnly(['userId', 'placeId', 'source', 'sources', 'checkedInAt', 'checkedOutAt']) &&
            d.userId == uid && d.placeId == placeId &&
            d.source in ['manual', 'qr', 'geofence', 'staff'] &&
            d.sources is list && d.sources.size() > 0 && d.sources.size() <= 4 &&
            d.sources.toSet().size() == d.sources.size() &&
            d.sources.hasOnly(['manual', 'qr', 'geofence', 'staff']) && d.source in d.sources &&
            d.checkedInAt is timestamp && (d.checkedOutAt == null || d.checkedOutAt is timestamp);
        }
        allow get: if active() && (request.auth.uid == uid || placeAccess(placeId, ['owner', 'manager', 'employee']));
        allow create: if validPresence() && canRecord(request.resource.data.source) &&
          exists(/databases/$(database)/documents/places/$(placeId)) &&
          get(/databases/$(database)/documents/users/$(uid)).data.get('active', true) == true &&
          request.resource.data.sources == [request.resource.data.source] && request.resource.data.checkedInAt == request.time &&
          request.resource.data.checkedOutAt == null;
        allow update: if validPresence() && (
          (resource.data.checkedOutAt == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sources']) &&
            request.resource.data.sources.hasAll(resource.data.sources) &&
            request.resource.data.sources.toSet().difference(resource.data.sources.toSet()).size() == 1 &&
            ((request.resource.data.sources.toSet().difference(resource.data.sources.toSet()).hasOnly(['manual']) && canRecord('manual')) ||
             (request.resource.data.sources.toSet().difference(resource.data.sources.toSet()).hasOnly(['qr']) && canRecord('qr')) ||
             (request.resource.data.sources.toSet().difference(resource.data.sources.toSet()).hasOnly(['geofence']) && canRecord('geofence')) ||
             (request.resource.data.sources.toSet().difference(resource.data.sources.toSet()).hasOnly(['staff']) && canRecord('staff')))) ||
          (resource.data.checkedOutAt == null && canRecord('geofence') && 'geofence' in resource.data.sources &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedOutAt']) && request.resource.data.checkedOutAt == request.time) ||
          (resource.data.checkedOutAt is timestamp && canRecord('geofence') && request.time > resource.data.checkedOutAt + duration.value(30, 'm') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['source', 'sources', 'checkedInAt', 'checkedOutAt']) &&
            request.resource.data.source == 'geofence' && request.resource.data.sources == ['geofence'] &&
            request.resource.data.checkedInAt == request.time && request.resource.data.checkedOutAt == null)
        );
        allow delete: if false;
      }
      match /customerContexts/{uid} {
        function validContext() {
          let d = request.resource.data;
          let session = getAfter(/databases/$(database)/documents/places/$(placeId)/serviceSessions/$(d.serviceSessionId)).data;
          let checkin = getAfter(/databases/$(database)/documents/places/$(placeId)/checkins/$(uid)).data;
          return d.keys().hasOnly(['userId', 'placeId', 'serviceSessionId', 'tableId', 'source', 'updatedAt']) &&
            d.userId == uid && d.placeId == placeId && d.serviceSessionId is string && d.source == 'qr' &&
            (d.tableId == null || d.tableId is string) && d.updatedAt == request.time &&
